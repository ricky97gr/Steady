# ===== 数据库 =====
DB_HOST=postgres
DB_PORT=5432
DB_USER=quant
DB_PASSWORD=quant_pass_2026
DB_NAME=quant_system

# ===== 数据源（V1 主源 AkShare，备选 Tushare）=====
TUSHARE_TOKEN=your_tushare_token

# ===== 日志 =====
LOG_LEVEL=info

# ===== 服务端口 =====
BACKEND_PORT=8080

# ===== 飞书通知（可选）=====
# 配置以数据库 app_config 表为准（设置页可改），仅以下作兜底；两者都未配置则通知不可用。
# FEISHU_NOTIFY_ENABLED=true
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_token
# DASHBOARD_URL=http://localhost
# FEISHU_REQUEST_TIMEOUT=10
# FEISHU_MAX_RETRIES=2
# FEISHU_SECRET=your_signature_secret   # 机器人开启签名校验后必填
# FEISHU_AT_ALL=true                    # 通知卡片 @所有人
